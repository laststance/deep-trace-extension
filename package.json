{
  "name": "deep-trace-navigation",
  "displayName": "Deep Trace Navigation",
  "description": "Replay deep-trace Markdown tables as native VS Code editor navigation steps.",
  "version": "0.1.1",
  "publisher": "laststance",
  "license": "MIT",
  "pricing": "Free",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/laststance/deep-trace-extension"
  },
  "bugs": {
    "url": "https://github.com/laststance/deep-trace-extension/issues"
  },
  "homepage": "https://github.com/laststance/deep-trace-extension#readme",
  "keywords": [
    "trace",
    "debug",
    "navigation",
    "code-flow",
    "execution-path",
    "deep-trace"
  ],
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Debuggers",
    "Visualization",
    "Other"
  ],
  "galleryBanner": {
    "color": "#2F6FEB",
    "theme": "dark"
  },
  "main": "./out/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onView:deepTrace.traceView",
    "onCommand:deepTrace.loadFromClipboard",
    "onCommand:deepTrace.nextStep",
    "onCommand:deepTrace.previousStep",
    "onCommand:deepTrace.revealCurrentStep",
    "onCommand:deepTrace.goToDefinition",
    "onCommand:deepTrace.setBreakpoints",
    "onCommand:deepTrace.clearBreakpoints"
  ],
  "scripts": {
    "vscode:prepublish": "pnpm build",
    "build": "node ./node_modules/typescript-compiler/bin/tsc -p tsconfig.build.json",
    "watch": "node ./node_modules/typescript-compiler/bin/tsc -w -p tsconfig.build.json",
    "typecheck": "node ./node_modules/typescript-compiler/bin/tsc -p .",
    "lint": "eslint . --concurrency=auto --max-warnings=0",
    "lint:fix": "eslint . --fix --concurrency=auto --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:docs": "node scripts/check-docs-links.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "health": "fallow health --fail-on-issues",
    "dupes": "fallow dupes --fail-on-issues",
    "dead-code": "fallow dead-code --fail-on-issues",
    "check": "pnpm format:check && pnpm check:docs && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm health && pnpm dupes && pnpm dead-code && pnpm package",
    "verify": "pnpm check && pnpm audit --prod",
    "package": "pnpm exec vsce package --no-dependencies",
    "publish:stores": "pnpm package && op run --env-file=.env.1password -- node scripts/publish-stores.mjs",
    "publish:stores:dry-run": "node scripts/publish-stores.mjs --dry-run"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "deepTrace",
          "title": "Deep Trace",
          "icon": "media/trace.svg"
        }
      ]
    },
    "views": {
      "deepTrace": [
        {
          "id": "deepTrace.traceView",
          "name": "Trace Steps"
        }
      ]
    },
    "commands": [
      {
        "command": "deepTrace.loadFromClipboard",
        "title": "Load Trace from Clipboard",
        "category": "Deep Trace",
        "icon": {
          "light": "media/light/load.svg",
          "dark": "media/dark/load.svg"
        }
      },
      {
        "command": "deepTrace.nextStep",
        "title": "Next Step",
        "category": "Deep Trace",
        "icon": {
          "light": "media/light/next.svg",
          "dark": "media/dark/next.svg"
        }
      },
      {
        "command": "deepTrace.previousStep",
        "title": "Previous Step",
        "category": "Deep Trace",
        "icon": {
          "light": "media/light/previous.svg",
          "dark": "media/dark/previous.svg"
        }
      },
      {
        "command": "deepTrace.setBreakpoints",
        "title": "Set Trace Breakpoints",
        "category": "Deep Trace",
        "icon": {
          "light": "media/light/set-breakpoints.svg",
          "dark": "media/dark/set-breakpoints.svg"
        }
      },
      {
        "command": "deepTrace.clearBreakpoints",
        "title": "Clear Trace Breakpoints",
        "category": "Deep Trace",
        "icon": {
          "light": "media/light/clear-breakpoints.svg",
          "dark": "media/dark/clear-breakpoints.svg"
        }
      },
      {
        "command": "deepTrace.revealCurrentStep",
        "title": "Reveal Current Step",
        "category": "Deep Trace"
      },
      {
        "command": "deepTrace.goToDefinition",
        "title": "Go to Definition from Current Step",
        "category": "Deep Trace"
      }
    ],
    "configuration": {
      "title": "Deep Trace",
      "properties": {
        "deepTrace.tabNavigation": {
          "type": "boolean",
          "default": true,
          "description": "Use Tab / Shift+Tab to move to the next / previous trace step while the cursor is on the current step line."
        }
      }
    },
    "keybindings": [
      {
        "command": "deepTrace.nextStep",
        "key": "tab",
        "when": "deepTrace.canGoNextFromCursor && editorTextFocus && !editorHasSelection && !editorReadonly && !suggestWidgetVisible && !inlineSuggestionVisible && !inlineEditIsVisible && !inSnippetMode && !editorTabMovesFocus && config.deepTrace.tabNavigation"
      },
      {
        "command": "deepTrace.previousStep",
        "key": "shift+tab",
        "when": "deepTrace.canGoPreviousFromCursor && editorTextFocus && !editorHasSelection && !editorReadonly && !suggestWidgetVisible && !inlineSuggestionVisible && !inlineEditIsVisible && !inSnippetMode && !editorTabMovesFocus && config.deepTrace.tabNavigation"
      }
    ],
    "chatSkills": [
      {
        "path": "./skills/deep-trace/SKILL.md"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "deepTrace.loadFromClipboard",
          "when": "view == deepTrace.traceView",
          "group": "navigation@1"
        },
        {
          "command": "deepTrace.setBreakpoints",
          "when": "view == deepTrace.traceView",
          "group": "navigation@2"
        },
        {
          "command": "deepTrace.clearBreakpoints",
          "when": "view == deepTrace.traceView",
          "group": "navigation@3"
        },
        {
          "command": "deepTrace.previousStep",
          "when": "view == deepTrace.traceView",
          "group": "navigation@4"
        },
        {
          "command": "deepTrace.nextStep",
          "when": "view == deepTrace.traceView",
          "group": "navigation@5"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "deepTrace.traceView",
        "contents": "No deep trace loaded yet.\n[Load Trace from Clipboard](command:deepTrace.loadFromClipboard)"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/vscode": "1.100.0",
    "@vitest/coverage-v8": "5.0.2",
    "@vscode/vsce": "^4.0.0",
    "eslint": "10.10.0",
    "eslint-config-ts-prefixer": "5.0.0",
    "fallow": "3.22.0",
    "prettier": "3.9.6",
    "typescript": "~6.0.3",
    "typescript-compiler": "npm:typescript@7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
